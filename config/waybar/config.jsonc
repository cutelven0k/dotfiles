{
    "layer": "bottom",
    "position": "top",

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpd",
        "custom/separator",
        "custom/weather",
        "custom/separator",
        "network",
        "bluetooth",
        "custom/airplane_mode",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "custom/layout",
        "custom/separator",
        "battery",
        "custom/separator",
        "tray"
    ],

    "custom/separator": {
        "format": "|",
        "interval": "once"
    },
    "custom/layout": {
        "exec": "layout.sh",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },
    "custom/weather": {
        "exec": "weather.sh Moscow",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "interval": 1800
    },
    "custom/airplane_mode": {
        "format": "{icon}",
        "format-icons": {
            "on": "󰀞",
            "off": "󰀝"
        },
        "exec": "airplane_mode.sh status",
        "interval": 1,
        "return-type": "json",
        "on-click": "airplane_mode.sh toggle"
    },

    "mpd": {
        "format": "{stateIcon}",
        "format-disconnected": "",
        "tooltip-format": "{artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "interval": 1,
        "on-click": "kitty -e rmpc "
    },
    "network": {
        "interface": "wlan0",
        "format": "{icon}",
        "format-disconnected": "󰣽",
        "format-disabled": "󰣽",
        "on-click": "kitty -e impala",
        "format-icons": [
            "󰢿",
            "󰢽",
            "󰢽",
            "󰢾"
        ],
        "interval": 1,
        "tooltip-format": "{ifname}"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂰",
        "on-click": "kitty -e bluetui",
        "tooltip-format": "{num_connections}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "{icon}",
        "format-icons": {
            "headphone": "󰋋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 1,
        "on-click": "kitty -e ncpamixer"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "states": {
            "critical": 20
        },
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "interval": 1,
        "events": {
            "on-discharging-critical": "battery.sh --critical",
            "on-charging-100": "battery.sh --full"
        }
    },
    "tray": {
        "icon-size": 13,
        "spacing": 10
    },

    "clock": {
        "interval": 60,
        "tooltip": true,
        "format": "{:%H:%M}",
        "tooltip-format": "{:%d/%m/%Y}"
    }
}
