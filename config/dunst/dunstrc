[global]
    height = (0, 200)
    width = (0, 250)
    offset = 10
    notification_limit = 5
    origin = bottom-right
    gap_size = 5
    font = Fira Code 9
    format = "<b>%s</b>\n%b"
    corner_radius = 2
    mouse_right_click = close_all
    follow = mouse
    idle_threshold = 120
    indicate_hidden = true
    corner_radius = 4

[urgency_low]
    background = "#1B1D2E"
    foreground = "#D6DEE4"
    frame_color = "#6FFFCC"
    timeout = 3

[urgency_normal]
    background = "#1B1D2E"
    foreground = "#D6DEE4"
    frame_color = "#6FFFCC"
    timeout = 10

[urgency_critical]
    background = "#1B1D2E"
    foreground = "#D6DEE4"
    frame_color = "#FF77AA"
    timeout = 10
